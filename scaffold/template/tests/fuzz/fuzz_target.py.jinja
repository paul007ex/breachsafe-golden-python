"""Atheris fuzz harness stub for {{ project_name }}.

This is the seed harness generated by breachsafe-repo. Point it at the first
parser in ``{{ module_name }}`` that consumes UNTRUSTED external input (a
user-supplied string, subprocess output, a file, a network response) and assert
the parser's failure contract: for any input it either returns a valid result
or raises ONLY its declared exception type -- never an unhandled crash. Add one
``fuzz_*.py`` file per such boundary; ``.clusterfuzzlite/build.sh`` compiles
every ``tests/fuzz/fuzz_*.py`` automatically.

Run with the ``fuzz`` optional dependency group; see ``tests/fuzz/README.md``.
"""

from __future__ import annotations

import sys
from contextlib import nullcontext

try:
    import atheris
except ImportError:  # pragma: no cover - atheris is an optional fuzz-only dependency
    atheris = None

# Instrument the module under test for coverage-guided fuzzing when atheris is
# present; fall back to a no-op context so the file stays importable in a normal
# dev environment where atheris is not installed.
_instrument = atheris.instrument_imports() if atheris is not None else nullcontext()
with _instrument:
    import {{ module_name }}  # noqa: F401 - imported for coverage instrumentation


def TestOneInput(data: bytes) -> None:  # noqa: N802 - atheris entrypoint naming
    """Drive one fuzzed input through a {{ project_name }} parser boundary.

    Replace the body below with a call to the real untrusted-input parser, e.g.::

        from {{ module_name }}.parser import parse, ParseError
        fdp = atheris.FuzzedDataProvider(data)
        try:
            parse(fdp.ConsumeUnicodeNoSurrogates(fdp.remaining_bytes()))
        except ParseError:
            return  # declared failure is fine; any OTHER exception is a finding
    """
    fdp = atheris.FuzzedDataProvider(data)
    # Seed behaviour: exercise the input decode path so the harness is runnable
    # out of the box. Swap this for the module's real parser (see docstring).
    _ = fdp.ConsumeUnicodeNoSurrogates(fdp.remaining_bytes())


def main() -> None:
    """Register the harness with libFuzzer and start fuzzing."""
    atheris.Setup(sys.argv, TestOneInput)
    atheris.Fuzz()


if __name__ == "__main__":
    main()
